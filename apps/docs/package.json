{
  "name": "@kifiya/docs",
  "private": true,
  "description": "Kifiya UI kit documentation site (Nextra).",
  "type": "module",
  "scripts": {
    "examples": "node scripts/generate-examples.mjs",
    "dev": "pnpm examples && next dev -p 3100",
    "build": "pnpm examples && next build",
    "test": "pnpm examples && vitest run",
    "typecheck": "pnpm examples && tsc --noEmit",
    "verify": "pnpm build"
  },
  "dependencies": {
    "@kifiya/tokens": "workspace:*",
    "@kifiya/ui": "workspace:*",
    "lucide-react": "^0.542.0",
    "next": "15.5.28",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.12",
    "vitest": "^4.1.2"
  }
}

{
  "name": "kifiya-ui",
  "private": true,
  "description": "Kifiya UI kit monorepo: design tokens, React components, hooks and flows.",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build:packages && pnpm -r test",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "verify": "pnpm -r verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "pnpm --filter @kifiya/tokens build && pnpm --filter @kifiya/ui build",
    "docs:dev": "pnpm build:packages && pnpm --filter @kifiya/docs dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}

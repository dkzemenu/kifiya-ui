{
  "name": "@kifiya/hooks",
  "version": "0.2.0",
  "description": "Kifiya React hooks: debounced values, pagination and drawer state, and a React Query mutation helper.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@kifiya/ui": "workspace:^",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@kifiya/ui": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kifiya/ui": "workspace:*",
    "@tanstack/react-query": "^5.96.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.0",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

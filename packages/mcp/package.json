{
  "name": "@kifiya/mcp",
  "version": "0.2.1",
  "description": "MCP server that lets coding assistants look up the Kifiya UI kit's components, props, examples and tokens.",
  "type": "module",
  "bin": {
    "kifiya-ui-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-data.mjs && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@kifiya/flows": "workspace:*",
    "@kifiya/tokens": "workspace:*",
    "@kifiya/ui": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

{
  "name": "@kifiya/flows",
  "version": "0.1.0",
  "description": "Kifiya screen flows: permission guard, app shell, sign-in and change-password forms, filterable list page.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@kifiya/hooks": "workspace:^",
    "@kifiya/ui": "workspace:^",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@kifiya/hooks": "workspace:*",
    "@kifiya/tokens": "workspace:*",
    "@kifiya/ui": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "lucide-react": "^0.542.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.0",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

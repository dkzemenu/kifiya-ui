# Loaded by direnv when you cd into this repo (run `direnv allow` once).
# Exports the variables in .env / .env.claude so .mcp.json's ${GITLAB_TOKEN} resolves.
# Both are gitignored and hook-protected; put values there, never in this file:
# this file is committed.
# CAUTION — some apps (Flutter flutter_dotenv repos) bundle .env INTO THE SHIPPED
# BINARY as an asset (pubspec.yaml assets list). In such repos the token goes in
# .env.claude, never .env, or it ships inside the APK/IPA.
dotenv_if_exists
dotenv_if_exists .env.claude
